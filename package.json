{
  "name": "pickleball-analytics",
  "version": "1.0.0",
  "description": "Pickleball league and stats tracking platform for clubs - manage players, matches, and leagues with ease",
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/pickleball-analytics"
  },
  "keywords": [
    "pickleball",
    "analytics",
    "league-management",
    "sports",
    "club-management",
    "nextjs",
    "saas",
    "multi-tenancy",
    "stripe",
    "authentication",
    "nextauth",
    "prisma",
